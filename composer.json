{
    "name": "alihabibian/hamkharid",
    "description": "Category-based complementary product recommendations for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Hamkharid\\SmartCategoryComplement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hamkharid\\SmartCategoryComplement\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "@php -l hamkharid.php",
            "@php -l src/Plugin.php",
            "@php -l src/Admin/RuleAdmin.php",
            "@php -l src/Admin/RuleMetaBox.php",
            "@php -l src/Admin/RuleListTable.php",
            "@php -l src/Matching/RuleMatcher.php",
            "@php -l src/Rules/Rule.php",
            "@php -l src/Rules/RulePostType.php",
            "@php -l src/Rules/RuleRepository.php",
            "@php -l tests/Unit/PluginTest.php",
            "@php -l tests/Unit/Rules/RuleTest.php",
            "@php -l tests/integration-rule-storage.php",
            "@php -l tests/integration-admin-crud.php",
            "@php -l tests/integration-rule-matching.php"
        ],
        "cs": "phpcs --standard=phpcs.xml.dist",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:integration": "@php tests/integration-rule-storage.php",
        "test:admin": "@php tests/integration-admin-crud.php",
        "test:matching": "@php tests/integration-rule-matching.php",
        "check": [
            "@lint",
            "@cs",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
